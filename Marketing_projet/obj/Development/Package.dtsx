      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{269A7753-E242-4A9D-980D-90E7676DA217}"
          SQLTask:SqlStatementSource="CREATE TABLE [fact_marketing_operations] (&#xA;    [user_id] VARCHAR(50),&#xA;    [product_id] VARCHAR(50),&#xA;    [Date] DATETIME,&#xA;    [order_id] VARCHAR(50),&#xA;    [review_id] VARCHAR(50),&#xA;    [Campaign_ID] VARCHAR(50),&#xA;&#xA;    [clicks] INT, &#xA;    [engagements] INT,&#xA;    [impressions] INT,&#xA;    [Duration] VARCHAR(50),&#xA;    [campaign_platform] VARCHAR(50),&#xA;    [total_amount] FLOAT,&#xA;    [quantity] VARCHAR(50),&#xA;    [order_status] VARCHAR(50),&#xA;    [rating] INT,&#xA;    [sentiment_score] INT,&#xA;    [review_text] VARCHAR(MAX),  &#xA;    &#xA;    CONSTRAINT FK_Client FOREIGN KEY (user_id) REFERENCES dim_clie(user_id),&#xA;    CONSTRAINT FK_Produit FOREIGN KEY (product_id) REFERENCES dim_produits(product_id),&#xA;    CONSTRAINT FK_DATE FOREIGN KEY ([Date]) REFERENCES dim_time([Date]),&#xA;    CONSTRAINT FK_ORDER FOREIGN KEY (order_id) REFERENCES dim_orders(order_id),&#xA;     CONSTRAINT FK_REVIEW FOREIGN KEY (review_id) REFERENCES Dim_Rev(review_id),&#xA;     CONSTRAINT FK_COMPAIGN FOREIGN KEY (Campaign_ID) REFERENCES dim_Camp(Campaign_ID)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\inserting data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tâche d'exécution de requêtes SQL"
      DTS:DTSID="{5C180FC4-9F39-4CA8-874E-7DBFC83CEEE4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="inserting data"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{269A7753-E242-4A9D-980D-90E7676DA217}"
          SQLTask:SqlStatementSource="INSERT INTO [fact_marketing_operations] (&#xA;    [user_id],&#xA;    [product_id],&#xA;    [Date],&#xA;    [order_id],&#xA;    [review_id],&#xA;    [Campaign_ID],&#xA;    [clicks],&#xA;    [engagements],&#xA;    [impressions],&#xA;    [Duration],&#xA;    [campaign_platform],&#xA;    [total_amount],&#xA;    [quantity],&#xA;    [order_status],&#xA;    [rating],&#xA;    [sentiment_score],&#xA;    [review_text]&#xA;)&#xA;SELECT&#xA;    oi.[user_id],&#xA;    oi.[product_id],&#xA;    t.[Date]                                    AS [Date],&#xA;    oi.[order_id],&#xA;    r.[review_id],&#xA;    c.[Campaign_ID],&#xA;    TRY_CAST(c.[Total_Clicks]      AS INT)      AS [clicks],&#xA;    TRY_CAST(c.[Total_Engagement]  AS INT)      AS [engagements],&#xA;    TRY_CAST(c.[Total_Impressions] AS INT)      AS [impressions],&#xA;    c.[Duration]                                AS [Duration],&#xA;    c.[Channel]                                 AS [campaign_platform],&#xA;    TRY_CAST(oi.[total_amount]     AS FLOAT)    AS [total_amount],&#xA;    oi.[quantity]                               AS [quantity],&#xA;    oi.[order_status]                           AS [order_status],&#xA;    r.[rating]                                  AS [rating],&#xA;    TRY_CAST(u.[avg_sentiment]     AS INT)      AS [sentiment_score],&#xA;    r.[review_text]                             AS [review_text]&#xA;&#xA;FROM&#xA;    [dim_orders]        oi&#xA;    INNER JOIN [dim_clie]   u   ON oi.[user_id]    = u.[user_id]&#xA;    LEFT JOIN  [Dim_Rev]    r   ON oi.[order_id]   = r.[order_id]&#xA;                               AND oi.[user_id]    = r.[user_id]&#xA;    LEFT JOIN  [dim_Camp]   c   ON c.[Product]     = oi.[product_id]&#xA;    LEFT JOIN  [dim_time]   t   ON t.[Date]        = TRY_CAST(u.[signup_date] AS DATE)&#xA;&#xA;WHERE&#xA;    oi.[order_id]   IS NOT NULL&#xA;AND oi.[user_id]    IS NOT NULL&#xA;&#xA;AND NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM [fact_marketing_operations] f&#xA;    WHERE f.[order_id]  = oi.[order_id]&#xA;    AND   f.[user_id]   = oi.[user_id]&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
