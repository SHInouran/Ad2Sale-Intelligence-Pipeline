END</Status>
          <TrendGraphic>Standard Arrow</TrendGraphic>
          <StatusGraphic>Gauge - Ascending</StatusGraphic>
        </Kpi>
        <Kpi>
          <ID>Indicateur de performance clé 2</ID>
          <Name>Revenue per Click Performance</Name>
          <AssociatedMeasureGroupID>v Fact Marketing</AssociatedMeasureGroupID>
          <Value>[Measures].[Revenue_per_Click]</Value>
          <Goal>2.5</Goal>
          <Status>CASE
    WHEN [Measures].[Revenue_per_Click] &gt;= 3 THEN 1
    WHEN [Measures].[Revenue_per_Click] &gt;= 1.5 THEN 0
    ELSE -1
END</Status>
          <TrendGraphic>Standard Arrow</TrendGraphic>
          <StatusGraphic>Gauge - Ascending</StatusGraphic>
        </Kpi>
        <Kpi>
          <ID>Indicateur de performance clé 3</ID>
          <Name>AOV Performance</Name>
          <AssociatedMeasureGroupID>v Fact Sales</AssociatedMeasureGroupID>
