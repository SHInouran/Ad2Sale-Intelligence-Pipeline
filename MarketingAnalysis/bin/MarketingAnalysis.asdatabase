      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/*
La commande CALCULATE contrôle l'agrégation des cellules feuilles dans le cube.
Si la commande CALCULATE est supprimée ou modifiée, les données au sein du cube sont affectées.
Vous devez modifier cette commande uniquement si vous spécifiez manuellement la façon dont le cube est agrégé.
*/
CALCULATE;   
CREATE MEMBER CURRENTCUBE.[Measures].CTR
 AS IIF([Measures].[Impressions] = 0, NULL, 
    [Measures].[Clicks] / [Measures].[Impressions]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].Engagement_Rate
 AS IIF([Measures].[Impressions] = 0, NULL, 
    [Measures].[Engagement] / [Measures].[Impressions]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ;   
CREATE MEMBER CURRENTCUBE.[Measures].AOV
 AS IIF([Measures].[Quantity] = 0, NULL, 
    [Measures].[Total Amount] / [Measures].[Quantity]), 
FORMAT_STRING = "Currency", 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].Revenue_per_Click
 AS IIF([Measures].[Clicks] = 0, NULL, 
    [Measures].[Total Amount] / [Measures].[Clicks]), 
FORMAT_STRING = "Currency", 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].Engagement_per_Click
 AS IIF([Measures].[Clicks] = 0, NULL,
    [Measures].[Engagements] / [Measures].[Clicks]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].RPM
 AS IIF([Measures].[Impressions] = 0, NULL,
    [Measures].[Total Amount] / [Measures].[Impressions]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;   
CREATE MEMBER CURRENTCUBE.[Measures].Conversion_Rate
 AS IIF([Measures].[Clicks] = 0, NULL,
    [Measures].[Quantity] / [Measures].[Clicks]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
      <Kpis>
        <Kpi>
          <ID>Indicateur de performance clé</ID>
          <Name>CTR Performance</Name>
          <AssociatedMeasureGroupID>v Fact Marketing</AssociatedMeasureGroupID>
          <Value>[Measures].[CTR]</Value>
          <Goal>0.025</Goal>
          <Status>CASE
    WHEN [Measures].[CTR] &gt;= 0.03 THEN 1
    WHEN [Measures].[CTR] &gt;= 0.015 THEN 0
    ELSE -1
END</Status>
          <TrendGraphic>Standard Arrow</TrendGraphic>
          <StatusGraphic>Gauge - Ascending</StatusGraphic>
        </Kpi>
        <Kpi>
